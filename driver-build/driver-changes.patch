+/* Translate the Broadcom vendor IE command used by the stock Mobis hostapd. */
+static int mobis_add_ie(struct net_device *net, const char *command)
+{
+	_adapter *adapter = (_adapter *)rtw_netdev_priv(net);
+	struct mlme_priv *mlme = &adapter->mlmepriv;
+	char oui[7], data[129], trailing;
+	u8 ie[69];
+	u32 mask;
+	int packet, i, high, low;
+	size_t data_length;
+
+	if (sscanf(command, "add_ie %d %6s %128s %c", &packet, oui, data, &trailing) != 3)
+		return -EINVAL;
+	data_length = strlen(data);
+	if (strlen(oui) != 6 || !data_length || data_length % 2)
+		return -EINVAL;
+
+	switch (packet) {
+	case 0:
+		mask = WIFI_BEACON_VENDOR_IE_BIT;
+		break;
+	case 1:
+		mask = WIFI_PROBERESP_VENDOR_IE_BIT;
+		break;
+	case 2:
+		mask = WIFI_ASSOCRESP_VENDOR_IE_BIT;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	ie[0] = WLAN_EID_VENDOR_SPECIFIC;
+	ie[1] = 3 + data_length / 2;
+	for (i = 0; i < 6 + data_length; i += 2) {
+		const char *source = i < 6 ? oui + i : data + i - 6;
+		high = hex_to_bin(source[0]);
+		low = hex_to_bin(source[1]);
+		if (high < 0 || low < 0)
+			return -EINVAL;
+		ie[2 + i / 2] = (high << 4) | low;
+	}
+
+	_rtw_memcpy(mlme->vendor_ie[0], ie, ie[1] + 2);
+	mlme->vendor_ielen[0] = ie[1] + 2;
+	mlme->vendor_ie_mask[0] |= mask;
+	update_beacon(adapter, 0xFF, NULL, _TRUE, 0);
+	return 0;
+}
